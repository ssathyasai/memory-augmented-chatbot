# Application Settings
APP_NAME="Memory-Augmented Chatbot"
DEBUG=False

# Security
JWT_SECRET_KEY="dev-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=24
PASSWORD_MIN_LENGTH=8

# MongoDB Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.p6q3neg.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="chatbot_db"

# Neo4j Configuration
# For Neo4j Aura:
#   NEO4J_URI: "neo4j+s://<instance-id>.databases.neo4j.io" (e.g., neo4j+s://fc54b344.databases.neo4j.io)
#   NEO4J_USER: "neo4j" (Always 'neo4j' for Aura; do NOT use the instance ID)
#   NEO4J_PASSWORD: "your-generated-aura-password"
#   NEO4J_DATABASE: "neo4j" (Always 'neo4j' for Aura)
# For local Neo4j:
#   NEO4J_URI: "bolt://localhost:7687"
#   NEO4J_USER: "neo4j"
#   NEO4J_PASSWORD: "your-local-password"
#   NEO4J_DATABASE: "neo4j"
NEO4J_URI="neo4j+s://fc54b344.databases.neo4j.io"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# GROQ API Configuration
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7

# Embeddings
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=8
SIMILARITY_THRESHOLD=0.40
MAX_CONTEXT_TOKENS=4000

# Vector Store
VECTOR_STORE_TYPE="faiss"
VECTOR_STORE_PATH="./vector_stores"

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=".pdf,.docx,.txt,.md"

# Rate Limiting
MAX_QUERIES_PER_MINUTE=30
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_MB_PER_USER=500

